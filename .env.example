# Copy to .env and adjust. Never commit .env.

# PostgreSQL. Matches docker-compose.yml; change if you installed Postgres yourself.
DATABASE_URL="postgresql://fpv:fpv@localhost:5432/fpv_procurement?schema=public"

# Auth.js. `npm run setup` fills this in; otherwise use any long random string.
AUTH_SECRET=""
# Required when running with `next start` outside Vercel (local hosting).
AUTH_TRUST_HOST=true

# Password given to the seeded demo users (see prisma/seed.ts).
SEED_PASSWORD="procurement"

# Where uploaded files are stored on this machine.
STORAGE_DIR="./storage"

# Business timezone for due dates, ETAs and the daily job.
APP_TIMEZONE="Asia/Dubai"

# Email: needed for two-step sign-in codes and the optional nightly digest.
# Use your email provider's SMTP details (port 587). "console" writes emails to logs/mail.log instead (testing).
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="FPV Procurement Hub <procurement@yourstore.ae>"
# APP_URL="http://192.168.1.20:3000"

# Set to 1 to stop the app from running the daily job itself.
# DISABLE_JOBS=1

# Two-step sign-in: after the password, users enter a 6-digit code emailed to them (needs SMTP_URL).
# off (default) | all | roles, e.g. ADMIN,FINANCE
# TWO_FACTOR="all"
